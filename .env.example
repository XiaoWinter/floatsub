# 从 Google AI Studio 复制。不要加引号。
GEMINI_API_KEY=

# 从阿里云百炼复制。不要加引号。
DASHSCOPE_API_KEY=

# gemini 或 qwen。窗口里也可以改。
FLOATSUB_PROVIDER=gemini

# 一般不用改。两边都走实时翻译。
GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview
QWEN_LIVE_MODEL=qwen3.8-livetranslate-flash-realtime
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
